/* Gray Style - QGrayStyleSheet ------------------------------------------ */
/*

See Qt documentation:

  - https://doc.qt.io/qt-5/stylesheet.html
  - https://doc.qt.io/qt-5/stylesheet-reference.html
  - https://doc.qt.io/qt-5/stylesheet-examples.html

--------------------------------------------------------------------------- */
/* Reset elements ------------------------------------------------------------

Resetting everything helps to unify styles across different operating systems

--------------------------------------------------------------------------- */
* {
  padding: 0px;
  margin: 0px;
  border: 0px;
  border-style: none;
  border-image: none;
  outline: 0;
}

/* specific reset for elements inside QToolBar */
QToolBar * {
  margin: 0px;
  padding: 0px;
}

/* QWidget ----------------------------------------------------------------

--------------------------------------------------------------------------- */
QWidget {
  background-color: #E5E5E5;
  border: 0px solid #D8D8D8;
  padding: 0px;
  color: #2D2D2D;
  selection-background-color: #A0A0A0;
  selection-color: #2D2D2D;
}
QWidget[no-style="true"] {
  background-color: none;
}
QWidget[Instance="true"], 
QWidget[Waveform="true"],
QWidget[Editor="true"],
QWidget[SecondEditor="true"],
QWidget[DriverLoad="true"] {
  border: 1px solid #7a7a7a;
  border-top: 1px solid #888888;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
}
QWidget[Waveform="true"],
QWidget[DriverLoad="true"] {
 border-bottom-left-radius: 4px;
 border-bottom-right-radius: 4px;
}
QWidget[Waveform="true"]
{
  border-top: none;
}
QWidget:disabled {
  background-color: #E5E5E5;
  color: #8A8A8A;
  selection-background-color: #C8C8C8;
  selection-color: #8A8A8A;
}
QWidget::item:selected {
  background-color: #A0A0A0;
}
QWidget::item:hover:!selected {
  background-color: #909090;
}

/* QMainWindow ------------------------------------------------------------

This adjusts the splitter in the dock widget, not qsplitter
https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qmainwindow

--------------------------------------------------------------------------- */
QMainWindow {
    background-color: #E5E5E5;
}

QMainWindow[Instance="true"], 
QMainWindow[Waveform="true"], 
QMainWindow[Editor="true"],
QMainWindow[SecondEditor="true"],
QMainWindow[DriverLoad="true"] {
  border: 1px solid #7a7a7a;
}

/* 更具体的规则，针对objectName为"mainWindow"的窗口 */
#mainWindow {
    background-color: #E5E5E5;
}
QMainWindow::title {
    background-color: #E5E5E5;
}
QMainWindow::separator {
  background-color: #D8D8D8;
  border: 0px solid #E5E5E5;
  spacing: 0px;
  padding: 2px;
}

QMainWindow::separator:hover {
  background-color: #B0B0B0;
  border: 0px solid #909090;
}

QMainWindow::separator:horizontal {
  width: 5px;
  margin-top: 2px;
  margin-bottom: 2px;
  image: url(":/icons/light/rc/toolbar_separator_vertical.png");
}

QMainWindow::separator:vertical {
  height: 5px;
  margin-left: 2px;
  margin-right: 2px;
  image: url(":/icons/light/rc/toolbar_separator_horizontal.png");
}

/* QToolTip ---------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtooltip

--------------------------------------------------------------------------- */
QToolTip {
  background-color: #A0A0A0;
  color: #2D2D2D;
  border: none;
  padding: 0px;
}

/* QStatusBar -------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qstatusbar

--------------------------------------------------------------------------- */
QStatusBar {
  border: 1px solid #D8D8D8;
  background: #D8D8D8;
}

QStatusBar::item {
  border: none;
}

QStatusBar QToolTip {
  background-color: #909090;
  border: 1px solid #E5E5E5;
  color: #E5E5E5;
  padding: 0px;
  opacity: 230;
}

QStatusBar QLabel {
  background: transparent;
}

/* QCheckBox --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qcheckbox

--------------------------------------------------------------------------- */
QCheckBox {
  background-color: #E5E5E5;
  color: #2D2D2D;
  spacing: 4px;
  outline: none;
  padding-top: 4px;
  padding-bottom: 4px;
}

QCheckBox:focus {
  border: none;
}

QCheckBox QWidget:disabled {
  background-color: #E5E5E5;
  color: #8A8A8A;
}

QCheckBox::indicator {
  margin-left: 2px;
  height: 14px;
  width: 14px;
}

QCheckBox::indicator:unchecked {
  image: url(":/icons/light/rc/checkbox_unchecked.png");
}

QCheckBox::indicator:unchecked:hover, QCheckBox::indicator:unchecked:focus, QCheckBox::indicator:unchecked:pressed {
  border: none;
  image: url(":/icons/light/rc/checkbox_unchecked_focus.png");
}

QCheckBox::indicator:unchecked:disabled {
  image: url(":/icons/light/rc/checkbox_unchecked_disabled.png");
}

QCheckBox::indicator:checked {
  image: url(":/icons/light/rc/checkbox_checked.png");
}

QCheckBox::indicator:checked:hover, QCheckBox::indicator:checked:focus, QCheckBox::indicator:checked:pressed {
  border: none;
  image: url(":/icons/light/rc/checkbox_checked_focus.png");
}

QCheckBox::indicator:checked:disabled {
  image: url(":/icons/light/rc/checkbox_checked_disabled.png");
}

QCheckBox::indicator:indeterminate {
  image: url(":/icons/light/rc/checkbox_indeterminate.png");
}

QCheckBox::indicator:indeterminate:disabled {
  image: url(":/icons/light/rc/checkbox_indeterminate_disabled.png");
}

QCheckBox::indicator:indeterminate:focus, QCheckBox::indicator:indeterminate:hover, QCheckBox::indicator:indeterminate:pressed {
  image: url(":/icons/light/rc/checkbox_indeterminate_focus.png");
}

/* QGroupBox --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qgroupbox

--------------------------------------------------------------------------- */
QGroupBox {
  font-weight: bold;
  border: 1px solid #D8D8D8;
  border-radius: 4px;
  padding: 2px;
  margin-top: 6px;
  margin-bottom: 4px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 4px;
  padding-left: 2px;
  padding-right: 4px;
  padding-top: -4px;
}

QGroupBox::indicator {
  margin-left: 2px;
  margin-top: 2px;
  padding: 0;
  height: 14px;
  width: 14px;
}

QGroupBox::indicator:unchecked {
  border: none;
  image: url(":/icons/light/rc/checkbox_unchecked.png");
}

QGroupBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:focus, QGroupBox::indicator:unchecked:pressed {
  border: none;
  image: url(":/icons/light/rc/checkbox_unchecked_focus.png");
}

QGroupBox::indicator:unchecked:disabled {
  image: url(":/icons/light/rc/checkbox_unchecked_disabled.png");
}

QGroupBox::indicator:checked {
  border: none;
  image: url(":/icons/light/rc/checkbox_checked.png");
}

QGroupBox::indicator:checked:hover, QGroupBox::indicator:checked:focus, QGroupBox::indicator:checked:pressed {
  border: none;
  image: url(":/icons/light/rc/checkbox_checked_focus.png");
}

QGroupBox::indicator:checked:disabled {
  image: url(":/icons/light/rc/checkbox_checked_disabled.png");
}


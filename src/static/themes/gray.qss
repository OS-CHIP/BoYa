/* QMenuBar ---------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qmenubar

--------------------------------------------------------------------------- */
QMenuBar {
  background-color: #D8D8D8;
  padding: 2px;
  border: 1px solid #E5E5E5;
  color: #2D2D2D;
  selection-background-color: #909090;
}

QMenuBar:focus {
  border: 1px solid #A0A0A0;
}

QMenuBar::item {
  background: transparent;
  padding: 4px;
}

QMenuBar::item:selected {
  padding: 4px;
  background: transparent;
  border: 0px solid #D8D8D8;
  background-color: #909090;
}

QMenuBar::item:pressed {
  padding: 4px;
  border: 0px solid #D8D8D8;
  background-color: #909090;
  color: #2D2D2D;
  margin-bottom: 0px;
  padding-bottom: 0px;
}

/* QMenu ------------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qmenu

--------------------------------------------------------------------------- */
QMenu {
  border: 1px solid #a7a7a7;
  color: #2D2D2D;
  margin: 0px;
  background-color: #DDDDDD;
  selection-background-color: #909090;
}

QMenu::separator {
  height: 1px;
  background-color: #B0B0B0;
  color: #2D2D2D;
}

QMenu::item {
  background-color: #DDDDDD;
  padding: 4px 24px 4px 28px;
  border: 1px transparent #D8D8D8;
}

QMenu::item:selected {
  color: #2D2D2D;
  background-color: #909090;
}

QMenu::item:pressed {
  background-color: #909090;
}

QMenu::icon {
  padding-left: 10px;
  width: 14px;
  height: 14px;
}

QMenu::indicator {
  padding-left: 8px;
  width: 12px;
  height: 12px;
}

QMenu::indicator:non-exclusive:unchecked {
  image: url(":/icons/light/rc/checkbox_unchecked.png");
}

QMenu::indicator:non-exclusive:unchecked:hover, QMenu::indicator:non-exclusive:unchecked:focus, QMenu::indicator:non-exclusive:unchecked:pressed {
  border: none;
  image: url(":/icons/light/rc/checkbox_unchecked_focus.png");
}

QMenu::indicator:non-exclusive:unchecked:disabled {
  image: url(":/icons/light/rc/checkbox_unchecked_disabled.png");
}

QMenu::indicator:non-exclusive:checked {
  image: url(":/icons/light/rc/checkbox_checked.png");
}

QMenu::indicator:non-exclusive:checked:hover, QMenu::indicator:non-exclusive:checked:focus, QMenu::indicator:non-exclusive:checked:pressed {
  border: none;
  image: url(":/icons/light/rc/checkbox_checked_focus.png");
}

QMenu::indicator:non-exclusive:checked:disabled {
  image: url(":/icons/light/rc/checkbox_checked_disabled.png");
}

QMenu::indicator:non-exclusive:indeterminate {
  image: url(":/icons/light/rc/checkbox_indeterminate.png");
}

QMenu::indicator:non-exclusive:indeterminate:disabled {
  image: url(":/icons/light/rc/checkbox_indeterminate_disabled.png");
}

QMenu::indicator:non-exclusive:indeterminate:focus, QMenu::indicator:non-exclusive:indeterminate:hover, QMenu::indicator:non-exclusive:indeterminate:pressed {
  image: url(":/icons/light/rc/checkbox_indeterminate_focus.png");
}

QMenu::indicator:exclusive:unchecked {
  image: url(":/icons/light/rc/radio_unchecked.png");
}

QMenu::indicator:exclusive:unchecked:hover, QMenu::indicator:exclusive:unchecked:focus, QMenu::indicator:exclusive:unchecked:pressed {
  border: none;
  outline: none;
  image: url(":/icons/light/rc/radio_unchecked_focus.png");
}

QMenu::indicator:exclusive:unchecked:disabled {
  image: url(":/icons/light/rc/radio_unchecked_disabled.png");
}

QMenu::indicator:exclusive:checked {
  border: none;
  outline: none;
  image: url(":/icons/light/rc/radio_checked.png");
}

QMenu::indicator:exclusive:checked:hover, QMenu::indicator:exclusive:checked:focus, QMenu::indicator:exclusive:checked:pressed {
  border: none;
  outline: none;
  image: url(":/icons/light/rc/radio_checked_focus.png");
}

QMenu::indicator:exclusive:checked:disabled {
  outline: none;
  image: url(":/icons/light/rc/radio_checked_disabled.png");
}

QMenu::right-arrow {
  margin: 5px;
  padding-left: 12px;
  image: url(":/icons/light/rc/arrow_right.png");
  height: 12px;
  width: 12px;
}

/* QAbstractItemView ------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qcombobox

--------------------------------------------------------------------------- */
QAbstractItemView {
  alternate-background-color: #E5E5E5;
  color: #2D2D2D;
  border: 1px solid #D8D8D8;
  border-radius: 4px;
}

QAbstractItemView QLineEdit {
  padding: 2px;
}

/* QAbstractScrollArea ----------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qabstractscrollarea

--------------------------------------------------------------------------- */
QAbstractScrollArea {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  border-radius: 4px;
  padding: 2px;
  color: #2D2D2D;
}

QAbstractScrollArea:disabled {
  color: #8A8A8A;
}

/* QScrollArea ------------------------------------------------------------

--------------------------------------------------------------------------- */
QScrollArea QWidget QWidget:disabled {
  background-color: #E5E5E5;
}

/* QScrollBar -------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qscrollbar

--------------------------------------------------------------------------- */
QScrollBar:horizontal {
  height: 12px;
  margin: 0px 12px 0px 12px;
  border: 0px solid #D8D8D8;
  border-radius: 4px;
  background-color: #E5E5E5;
}

QScrollBar:vertical {
  background-color: #E5E5E5;
  width: 12px;
  margin: 12px 0px 12px 0px;
  border: 0px solid #D8D8D8;
  border-radius: 4px;
}

QScrollBar::handle:horizontal {
  background-color: #B0B0B0;
  border: 1px solid #D8D8D8;
  border-radius: 2px;
  min-width: 8px;
}

QScrollBar::handle:horizontal:hover {
  background-color: #A0A0A0;
  border: #A0A0A0;
  border-radius: 2px;
  min-width: 8px;
}

QScrollBar::handle:horizontal:focus {
  border: 1px solid #909090;
}

QScrollBar::handle:vertical {
  background-color: #B0B0B0;
  border: 1px solid #D8D8D8;
  min-height: 8px;
  border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
  background-color: #A0A0A0;
  border: #A0A0A0;
  border-radius: 2px;
  min-height: 8px;
}

QScrollBar::handle:vertical:focus {
  border: 1px solid #909090;
}

QScrollBar::add-line:horizontal {
  margin: 0px 0px 0px 0px;
  border-image: url(":/icons/light/rc/arrow_right_disabled.png");
  height: 10px;
  width: 10px;
  subcontrol-position: right;
  subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover, QScrollBar::add-line:horizontal:on {
  border-image: url(":/icons/light/rc/arrow_right.png");
  height: 10px;
  width: 10px;
  subcontrol-position: right;
  subcontrol-origin: margin;
}

QScrollBar::add-line:vertical {
  margin: 3px 0px 3px 0px;
  border-image: url(":/icons/light/rc/arrow_down_disabled.png");
  height: 10px;
  width: 10px;
  subcontrol-position: bottom;
  subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover, QScrollBar::add-line:vertical:on {
  border-image: url(":/icons/light/rc/arrow_down.png");
  height: 10px;
  width: 10px;
  subcontrol-position: bottom;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
  margin: 0px 3px 0px 3px;
  border-image: url(":/icons/light/rc/arrow_left_disabled.png");
  height: 10px;
  width: 10px;
  subcontrol-position: left;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:hover, QScrollBar::sub-line:horizontal:on {
  border-image: url(":/icons/light/rc/arrow_left.png");
  height: 10px;
  width: 10px;
  subcontrol-position: left;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
  margin: 3px 0px 3px 0px;
  border-image: url(":/icons/light/rc/arrow_up_disabled.png");
  height: 10px;
  width: 10px;
  subcontrol-position: top;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover, QScrollBar::sub-line:vertical:on {
  border-image: url(":/icons/light/rc/arrow_up.png");
  height: 10px;
  width: 10px;
  subcontrol-position: top;
  subcontrol-origin: margin;
}

QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal {
  background: none;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
  background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}

/* QTextEdit --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-specific-widgets

--------------------------------------------------------------------------- */
QTextEdit {
  background-color: #E5E5E5;
  color: #2D2D2D;
  border-radius: 4px;
  border: 1px solid #D8D8D8;
}

QTextEdit:focus {
  border: 1px solid #909090;
}

QTextEdit:selected {
  background: #A0A0A0;
  color: #D8D8D8;
}

/* QPlainTextEdit ---------------------------------------------------------

--------------------------------------------------------------------------- */
QPlainTextEdit {
  background-color: #E5E5E5;
  color: #2D2D2D;
  border-radius: 4px;
  border: 1px solid #D8D8D8;
}

QPlainTextEdit:focus {
  border: 1px solid #909090;
}

QPlainTextEdit:selected {
  background: #A0A0A0;
  color: #D8D8D8;
}

/* QSizeGrip --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qsizegrip

--------------------------------------------------------------------------- */
QSizeGrip {
  background: transparent;
  width: 12px;
  height: 12px;
  image: url(":/icons/light/rc/window_grip.png");
}

/* QStackedWidget ---------------------------------------------------------

--------------------------------------------------------------------------- */
QStackedWidget {
  padding: 2px;
  border: 1px solid #D8D8D8;
  border: 1px solid #E5E5E5;
}

/* QToolBar ---------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtoolbar

--------------------------------------------------------------------------- */
QToolBar {
  background-color: #D8D8D8;
  border-bottom: 1px solid #E5E5E5;
  padding: 1px;
  font-weight: bold;
  spacing: 2px;
}

QToolBar[waveWindowMainToolBar="true"] {
  border-bottom: 1px solid #6d6d6d;
}

QToolBar:disabled {
  background-color: #D8D8D8;
}

QToolBar::handle:horizontal {
  width: 16px;
  image: url(":/icons/light/rc/toolbar_move_horizontal.png");
}

QToolBar::handle:vertical {
  height: 16px;
  image: url(":/icons/light/rc/toolbar_move_vertical.png");
}

QToolBar::separator:horizontal {
  width: 16px;
  image: url(":/icons/light/rc/toolbar_separator_horizontal.png");
}

QToolBar::separator:vertical {
  height: 16px;
  image: url(":/icons/light/rc/toolbar_separator_vertical.png");
}

QToolButton#qt_toolbar_ext_button {
  background: #D8D8D8;
  border: 0px;
  color: #2D2D2D;
  image: url(":/icons/light/rc/arrow_right.png");
}

/* QAbstractSpinBox -------------------------------------------------------

--------------------------------------------------------------------------- */
QAbstractSpinBox {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #2D2D2D;
  padding-top: 2px;
  padding-bottom: 2px;
  padding-left: 4px;
  padding-right: 4px;
  border-radius: 4px;
}

QAbstractSpinBox:up-button {
  background-color: transparent #E5E5E5;
  subcontrol-origin: border;
  subcontrol-position: top right;
  border-left: 1px solid #D8D8D8;
  border-bottom: 1px solid #D8D8D8;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  margin: 1px;
  width: 12px;
  margin-bottom: -1px;
}

QAbstractSpinBox::up-arrow, QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::up-arrow:off {
  image: url(":/icons/light/rc/arrow_up_disabled.png");
  height: 8px;
  width: 8px;
}

QAbstractSpinBox::up-arrow:hover {
  image: url(":/icons/light/rc/arrow_up.png");
}

QAbstractSpinBox:down-button {
  background-color: transparent #E5E5E5;
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  border-left: 1px solid #D8D8D8;
  border-top: 1px solid #D8D8D8;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  margin: 1px;
  width: 12px;
  margin-top: -1px;
}

QAbstractSpinBox::down-arrow, QAbstractSpinBox::down-arrow:disabled, QAbstractSpinBox::down-arrow:off {
  image: url(":/icons/light/rc/arrow_down_disabled.png");
  height: 8px;
  width: 8px;
}

QAbstractSpinBox::down-arrow:hover {
  image: url(":/icons/light/rc/arrow_down.png");
}

QAbstractSpinBox:hover {
  border: 1px solid #A0A0A0;
  color: #2D2D2D;
}

QAbstractSpinBox:focus {
  border: 1px solid #909090;
}

QAbstractSpinBox:selected {
  background: #A0A0A0;
  color: #D8D8D8;
}

/* ------------------------------------------------------------------------ */
/* DISPLAYS --------------------------------------------------------------- */
/* ------------------------------------------------------------------------ */
/* QLabel -----------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qframe

--------------------------------------------------------------------------- */
QLabel {
  background-color: #E5E5E5;
  border: 0px solid #D8D8D8;
  padding: 2px;
  margin: 0px;
  color: #2D2D2D;
}

QLabel:disabled {
  background-color: #E5E5E5;
  border: 0px solid #D8D8D8;
  color: #8A8A8A;
}

/* QTextBrowser -----------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qabstractscrollarea

--------------------------------------------------------------------------- */
QTextBrowser {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #2D2D2D;
  border-radius: 4px;
}

QTextBrowser:disabled {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #8A8A8A;
  border-radius: 4px;
}

QTextBrowser:hover, QTextBrowser:!hover, QTextBrowser:selected, QTextBrowser:pressed {
  border: 1px solid #D8D8D8;
}

/* QGraphicsView ----------------------------------------------------------

--------------------------------------------------------------------------- */
QGraphicsView {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #2D2D2D;
  border-radius: 4px;
}

QGraphicsView:disabled {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #8A8A8A;
  border-radius: 4px;
}

QGraphicsView:hover, QGraphicsView:!hover, QGraphicsView:selected, QGraphicsView:pressed {
  border: 1px solid #D8D8D8;
}

/* QCalendarWidget --------------------------------------------------------

--------------------------------------------------------------------------- */
QCalendarWidget {
  border: 1px solid #D8D8D8;
  border-radius: 4px;
}

QCalendarWidget:disabled {
  background-color: #E5E5E5;
  color: #8A8A8A;
}

/* QLCDNumber -------------------------------------------------------------

--------------------------------------------------------------------------- */
QLCDNumber {
  background-color: #E5E5E5;
  color: #2D2D2D;
}

QLCDNumber:disabled {
  background-color: #E5E5E5;
  color: #8A8A8A;
}

/* QProgressBar -----------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qprogressbar

--------------------------------------------------------------------------- */
QProgressBar {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #2D2D2D;
  border-radius: 4px;
  text-align: center;
}

QProgressBar:disabled {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #8A8A8A;
  border-radius: 4px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #A0A0A0;
  color: #E5E5E5;
  border-radius: 4px;
}

QProgressBar::chunk:disabled {
  background-color: #C8C8C8;
  color: #8A8A8A;
  border-radius: 4px;
}

/* ------------------------------------------------------------------------ */
/* BUTTONS ---------------------------------------------------------------- */
/* ------------------------------------------------------------------------ */
/* QPushButton ------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qpushbutton

--------------------------------------------------------------------------- */
QPushButton {
  background-color: #D8D8D8;
  border: 1px solid #E5E5E5;
  color: #2D2D2D;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QPushButton:disabled {
  background-color: #D8D8D8;
  color: #8A8A8A;
  border-radius: 4px;
  padding: 2px;
}

QPushButton:checked {
  background-color: #B0B0B0;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QPushButton:checked:disabled {
  background-color: #B0B0B0;
  color: #8A8A8A;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QPushButton:checked:selected {
  background: #B0B0B0;
}

QPushButton:hover {
  background-color: #C0C0C0;
  color: #2D2D2D;
}

QPushButton:pressed {
  background-color: #B0B0B0;
}

QPushButton:selected {
  background: #B0B0B0;
  color: #2D2D2D;
}

QPushButton::menu-indicator {
  subcontrol-origin: padding;
  subcontrol-position: bottom right;
  bottom: 4px;
}

QDialogButtonBox QPushButton {
  min-width: 80px;
}

/* QToolButton ------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtoolbutton

--------------------------------------------------------------------------- */
QToolButton {
  background-color: #D8D8D8;
  border: 1px solid #E5E5E5;
  color: #2D2D2D;
  border-radius: 4px;
  padding: 2px;
  outline: none;
  border: none;
}

QToolButton:disabled {
  background-color: #D8D8D8;
  color: #8A8A8A;
  border-radius: 4px;
  padding: 2px;
}

QToolButton:checked {
  background-color: #B0B0B0;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QToolButton:checked:disabled {
  background-color: #B0B0B0;
  color: #8A8A8A;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QToolButton:checked:hover {
  background-color: #C0C0C0;
  color: #2D2D2D;
}

QToolButton:checked:pressed {
  background-color: #B0B0B0;
}

QToolButton:checked:selected {
  background: #B0B0B0;
  color: #2D2D2D;
}

QToolButton:hover {
  background-color: #C0C0C0;
  color: #2D2D2D;
}

QToolButton:pressed {
  background-color: #B0B0B0;
}

QToolButton:selected {
  background: #B0B0B0;
  color: #2D2D2D;
}

QToolButton[popupMode="0"] {
  padding-right: 2px;
}

QToolButton[popupMode="1"] {
  padding-right: 20px;
}

QToolButton[popupMode="1"]::menu-button {
  border: none;
}

QToolButton[popupMode="1"]::menu-button:hover {
  border: none;
  border-left: 1px solid #D8D8D8;
  border-radius: 0;
}

QToolButton[popupMode="2"] {
  padding-right: 2px;
}

QToolButton::menu-button {
  padding: 2px;
  border-radius: 4px;
  width: 12px;
  border: none;
  outline: none;
}

QToolButton::menu-button:hover {
  border: 1px solid #A0A0A0;
}

QToolButton::menu-button:checked:hover {
  border: 1px solid #A0A0A0;
}

QToolButton::menu-indicator {
  image: url(":/icons/light/rc/arrow_down.png");
  height: 8px;
  width: 8px;
  top: 0;
  left: -2px;
}

QToolButton::menu-arrow {
  image: url(":/icons/light/rc/arrow_down.png");
  height: 8px;
  width: 8px;
}

QToolButton::menu-arrow:hover {
  image: url(":/icons/light/rc/arrow_down_focus.png");
}

/* QCommandLinkButton -----------------------------------------------------

--------------------------------------------------------------------------- */
QCommandLinkButton {
  background-color: transparent;
  border: 1px solid #D8D8D8;
  color: #2D2D2D;
  border-radius: 4px;
  padding: 0px;
  margin: 0px;
}

QCommandLinkButton:disabled {
  background-color: transparent;
  color: #8A8A8A;
}

/* ------------------------------------------------------------------------ */
/* INPUTS - NO FIELDS ----------------------------------------------------- */
/* ------------------------------------------------------------------------ */
/* QComboBox --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qcombobox

--------------------------------------------------------------------------- */
QComboBox {
  border: 1px solid #a5a5a5;
  border-radius: 4px;
  selection-background-color: #A0A0A0;
  padding-left: 4px;
  padding-right: 4px;
  min-height: 1.5em;
}

QComboBox QAbstractItemView {
  border: 1px solid #D8D8D8;
  border-radius: 0;
  background-color: #E5E5E5;
  selection-background-color: #A0A0A0;
}

QComboBox QAbstractItemView:hover {
  background-color: #E5E5E5;
  color: #2D2D2D;
}

QComboBox QAbstractItemView:selected {
  background: #A0A0A0;
  color: #D8D8D8;
}

QComboBox QAbstractItemView:alternate {
  background: #E5E5E5;
}

QComboBox:disabled {
  background-color: #E5E5E5;
  color: #8A8A8A;
}

QComboBox:hover {
  border: 1px solid #A0A0A0;
}

QComboBox:focus {
  border: 1px solid #909090;
}

QComboBox:on {
  selection-background-color: #A0A0A0;
}

QComboBox::indicator {
  border: none;
  border-radius: 0;
  background-color: transparent;
  selection-background-color: transparent;
  color: transparent;
  selection-color: transparent;
}

QComboBox::indicator:alternate {
  background: #E5E5E5;
}

QComboBox::item:alternate {
  background: #E5E5E5;
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 12px;
  border-left: 1px solid #D8D8D8;
}

QComboBox::down-arrow {
  image: url(":/icons/light/rc/arrow_down_disabled.png");
  height: 8px;
  width: 8px;
}

QComboBox::down-arrow:on, QComboBox::down-arrow:hover, QComboBox::down-arrow:focus {
  image: url(":/icons/light/rc/arrow_down.png");
}

/* QSlider ----------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qslider

--------------------------------------------------------------------------- */
QSlider:disabled {
  background: #E5E5E5;
}

QSlider:focus {
  border: none;
}

QSlider::groove:horizontal {
  background: #D8D8D8;
  border: 1px solid #D8D8D8;
  height: 4px;
  margin: 0px;
  border-radius: 4px;
}

QSlider::groove:vertical {
  background: #D8D8D8;
  border: 1px solid #D8D8D8;
  width: 4px;
  margin: 0px;
  border-radius: 4px;
}

QSlider::add-page:vertical {
  background: #A0A0A0;
  border: 1px solid #D8D8D8;
  width: 4px;
  margin: 0px;
  border-radius: 4px;
}

QSlider::add-page:vertical :disabled {
  background: #C8C8C8;
}

QSlider::sub-page:horizontal {
  background: #A0A0A0;
  border: 1px solid #D8D8D8;
  height: 4px;
  margin: 0px;
  border-radius: 4px;
}

QSlider::sub-page:horizontal:disabled {
  background: #C8C8C8;
}

QSlider::handle:horizontal {
  background: #909090;
  border: 1px solid #D8D8D8;
  width: 8px;
  height: 8px;
  margin: -8px 0px;
  border-radius: 2px;
}

QSlider::handle:horizontal:hover {
  background: #A0A0A0;
  border: 1px solid #A0A0A0;
}

QSlider::handle:horizontal:focus {
  border: 1px solid #909090;
}

QSlider::handle:vertical {
  background: #909090;
  border: 1px solid #D8D8D8;
  width: 8px;
  height: 8px;
  margin: 0 -8px;
  border-radius: 2px;
}

QSlider::handle:vertical:hover {
  background: #A0A0A0;
  border: 1px solid #A0A0A0;
}

QSlider::handle:vertical:focus {
  border: 1px solid #909090;
}

/* QLineEdit --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qlineedit

--------------------------------------------------------------------------- */
QLineEdit {
  background-color: #E5E5E5;
  padding-top: 2px;
  padding-bottom: 2px;
  padding-left: 4px;
  padding-right: 4px;
  border-style: solid;
  border: 1px solid #a5a5a5;
  border-radius: 4px;
  color: #2D2D2D;
}

QLineEdit:disabled {
  background-color: #E5E5E5;
  color: #8A8A8A;
}

QLineEdit:hover {
  border: 1px solid #A0A0A0;
  color: #2D2D2D;
}

QLineEdit:focus {
  border: 1px solid #909090;
}

QLineEdit:selected {
  background-color: #A0A0A0;
  color: #D8D8D8;
}

/* QTabWiget --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtabwidget-and-qtabbar

--------------------------------------------------------------------------- */
QTabBar, QDockWidget QTabBar {
  qproperty-drawBase: 0;
  border-radius: 4px;
  margin: 0px;
  padding: 2px;
  border: 0;
}

QTabBar::close-button, QDockWidget QTabBar::close-button {
  border: 0;
  margin: 0;
  padding: 4px;
  image: url(":/icons/light/rc/window_close.png");
}

QTabBar::close-button:hover, QDockWidget QTabBar::close-button:hover {
  image: url(":/icons/light/rc/window_close_focus.png");
}

QTabBar::close-button:pressed, QDockWidget QTabBar::close-button:pressed {
  image: url(":/icons/light/rc/window_close_pressed.png");
}

QTabBar::tab:top:selected:disabled, QDockWidget QTabBar::tab:top:selected:disabled {
  border-bottom: 3px solid #C8C8C8;
  color: #8A8A8A;
  background-color: #D8D8D8;
}

QTabBar::tab:bottom:selected:disabled, QDockWidget QTabBar::tab:bottom:selected:disabled {
  border-top: 3px solid #C8C8C8;
  color: #8A8A8A;
  background-color: #D8D8D8;
}

QTabBar::tab:left:selected:disabled, QDockWidget QTabBar::tab:left:selected:disabled {
  border-right: 3px solid #C8C8C8;
  color: #8A8A8A;
  background-color: #D8D8D8;
}

QTabBar::tab:right:selected:disabled, QDockWidget QTabBar::tab:right:selected:disabled {
  border-left: 3px solid #C8C8C8;
  color: #8A8A8A;
  background-color: #D8D8D8;
}

QTabBar::tab:top:!selected:disabled, QDockWidget QTabBar::tab:top:!selected:disabled {
  border-bottom: 3px solid #E5E5E5;
  color: #8A8A8A;
  background-color: #E5E5E5;
}

QTabBar::tab:bottom:!selected:disabled, QDockWidget QTabBar::tab:bottom:!selected:disabled {
  border-top: 3px solid #E5E5E5;
  color: #8A8A8A;
  background-color: #E5E5E5;
}

QTabBar::tab:left:!selected:disabled, QDockWidget QTabBar::tab:left:!selected:disabled {
  border-right: 3px solid #E5E5E5;
  color: #8A8A8A;
  background-color: #E5E5E5;
}

QTabBar::tab:right:!selected:disabled, QDockWidget QTabBar::tab:right:!selected:disabled {
  border-left: 3px solid #E5E5E5;
  color: #8A8A8A;
  background-color: #E5E5E5;
}

QTabBar::tab:top:!selected, QDockWidget QTabBar::tab:top:!selected {
  border-bottom: 2px solid #E5E5E5;
  margin-top: 2px;
}

QTabBar::tab:bottom:!selected, QDockWidget QTabBar::tab:bottom:!selected {
  border-top: 2px solid #E5E5E5;
  margin-bottom: 2px;
}

QTabBar::tab:left:!selected, QDockWidget QTabBar::tab:left:!selected {
  border-left: 2px solid #E5E5E5;
  margin-right: 2px;
}

QTabBar::tab:right:!selected, QDockWidget QTabBar::tab:right:!selected {
  border-right: 2px solid #E5E5E5;
  margin-left: 2px;
}

QTabBar::tab:top, QDockWidget QTabBar::tab:top {
  background-color: #D8D8D8;
  margin-left: 2px;
  padding-left: 4px;
  padding-right: 4px;
  padding-top: 2px;
  padding-bottom: 2px;
  min-width: 5px;
  border-bottom: 3px solid #D8D8D8;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QTabBar::tab:top:selected, QDockWidget QTabBar::tab:top:selected {
  background-color: #C0C0C0;
  border-bottom: 3px solid #6B6B6B;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QTabBar::tab:top:!selected:hover, QDockWidget QTabBar::tab:top:!selected:hover {
  border: 1px solid #909090;
  border-bottom: 3px solid #909090;
  padding-left: 3px;
  padding-right: 3px;
}

QTabBar::tab:bottom, QDockWidget QTabBar::tab:bottom {
  border-top: 3px solid #D8D8D8;
  background-color: #D8D8D8;
  margin-left: 2px;
  padding-left: 4px;
  padding-right: 4px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-bottom-left-radius: 4px;
  border-bottom-right-radius: 4px;
  min-width: 5px;
}

QTabBar::tab:bottom:selected, QDockWidget QTabBar::tab:bottom:selected {
  background-color: #C0C0C0;
  border-top: 3px solid #6B6B6B;
  border-bottom-left-radius: 4px;
  border-bottom-right-radius: 4px;
}

QTabBar::tab:bottom:!selected:hover, QDockWidget QTabBar::tab:bottom:!selected:hover {
  border: 1px solid #909090;
  border-top: 3px solid #909090;
  padding-left: 3px;
  padding-right: 3px;
}

QTabBar::tab:left, QDockWidget QTabBar::tab:left {
  background-color: #D8D8D8;
  margin-top: 2px;
  padding-left: 2px;
  padding-right: 2px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-top-left-radius: 4px;
  border-bottom-left-radius: 4px;
  min-height: 5px;
}

QTabBar::tab:left:selected, QDockWidget QTabBar::tab:left:selected {
  background-color: #C0C0C0;
  border-right: 3px solid #6B6B6B;
}

QTabBar::tab:left:!selected:hover, QDockWidget QTabBar::tab:left:!selected:hover {
  border: 1px solid #909090;
  border-right: 3px solid #909090;
  margin-right: 0px;
  padding-right: -1px;
}

QTabBar::tab:right, QDockWidget QTabBar::tab:right {
  background-color: #D8D8D8;
  margin-top: 2px;
  padding-left: 2px;
  padding-right: 2px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;
  min-height: 5px;
}

QTabBar::tab:right:selected, QDockWidget QTabBar::tab:right:selected {
  background-color: #C0C0C0;
  border-left: 3px solid #6B6B6B;
}

QTabBar::tab:right:!selected:hover, QDockWidget QTabBar::tab:right:!selected:hover {
  border: 1px solid #909090;
  border-left: 3px solid #909090;
  margin-left: 0px;
  padding-left: 0px;
}

QTabBar QToolButton, QDockWidget QTabBar QToolButton {
  background-color: #D8D8D8;
  height: 12px;
  width: 12px;
}

QTabBar QToolButton:pressed, QDockWidget QTabBar QToolButton:pressed {
  background-color: #D8D8D8;
}

QTabBar QToolButton:pressed:hover, QDockWidget QTabBar QToolButton:pressed:hover {
  border: 1px solid #A0A0A0;
}

QTabBar QToolButton::left-arrow:enabled, QDockWidget QTabBar QToolButton::left-arrow:enabled {
  image: url(":/icons/light/rc/arrow_left.png");
}

QTabBar QToolButton::left-arrow:disabled, QDockWidget QTabBar QToolButton::left-arrow:disabled {
  image: url(":/icons/light/rc/arrow_left_disabled.png");
}

QTabBar QToolButton::right-arrow:enabled, QDockWidget QTabBar QToolButton::right-arrow:enabled {
  image: url(":/icons/light/rc/arrow_right.png");
}

QTabBar QToolButton::right-arrow:disabled, QDockWidget QTabBar QToolButton::right-arrow:disabled {
  image: url(":/icons/light/rc/arrow_right_disabled.png");
}

/* QDockWiget -------------------------------------------------------------

--------------------------------------------------------------------------- */
QDockWidget {
  outline: 1px solid #D8D8D8;
  background-color: #E5E5E5;
  border: 1px solid #7a7a7a;
  border-radius: 4px;
  titlebar-close-icon: url(":/icons/light/rc/transparent.png");
  titlebar-normal-icon: url(":/icons/light/rc/transparent.png");
}

QDockWidget[no-style="true"] {
  background-color: none;
}

QDockWidget::title {
  padding: 3px;
  spacing: 4px;
  border: none;
  /* background-color: #C8C8C8; */
  color: #2D2D2D;  
  background-color: qlineargradient(x1:1, y1:0, x2:1, y2:1, stop:0 #e0e4e6, stop:1 #a0a4a8);  
}

QDockWidget::title:hover {
    background-color: qlineargradient(x1:1, y1:0, x2:1, y2:1, stop:0 #f0f4f6, stop:1 #b0b4b8);
}

QDockWidget[Instance="true"]::title, 
QDockWidget[Waveform="true"]::title, 
QDockWidget[Editor="true"]::title,
QDockWidget[SecondEditor="true"]::title,
QDockWidget[DriverLoad="true"]::title {
  border-top: 1px solid #7a7a7a;
  border-left: 1px solid #7a7a7a;
  border-right: 1px solid #7a7a7a;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
}
/* QDockWidget[Waveform="true"]::title {
  border-bottom: 1px solid #888888;
} */

QDockWidget QWidget[DockWidgetTile="true"]
{
  border-top: 1px solid #7a7a7a;
  border-left: 1px solid #7a7a7a;
  border-right: 1px solid #7a7a7a;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
}

QDockWidget::close-button {
  icon-size: 12px;
  border: none;
  background: transparent;
  background-image: transparent;
  border: 0;
  margin: 0;
  padding: 0;
  image: url(":/icons/light/rc/window_close.png");
}

QDockWidget::close-button:hover {
  image: url(":/icons/light/rc/window_close_focus.png");
}

QDockWidget::close-button:pressed {
  image: url(":/icons/light/rc/window_close_pressed.png");
}

QDockWidget::float-button {
  icon-size: 12px;
  border: none;
  background: transparent;
  background-image: transparent;
  border: 0;
  margin: 0;
  padding: 0;
  image: url(":/icons/light/rc/window_undock.png");
}

QDockWidget::float-button:hover {
  image: url(":/icons/light/rc/window_undock_focus.png");
}

QDockWidget::float-button:pressed {
  image: url(":/icons/light/rc/window_undock_pressed.png");
}

/* QTreeView QListView QTableView -----------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtreeview
https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qlistview
https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtableview

--------------------------------------------------------------------------- */
QTreeView:branch:selected, QTreeView:branch:hover {
  background: url(":/icons/light/rc/transparent.png");
}

QTreeView:branch:has-siblings:!adjoins-item {
  border-image: url(":/icons/light/rc/branch_line.png") 0;
}

QTreeView:branch:has-siblings:adjoins-item {
  border-image: url(":/icons/light/rc/branch_more.png") 0;
}

QTreeView:branch:!has-children:!has-siblings:adjoins-item {
  border-image: url(":/icons/light/rc/branch_end.png") 0;
}

QTreeView:branch:has-children:!has-siblings:closed, QTreeView:branch:closed:has-children:has-siblings {
  border-image: none;
  image: url(":/icons/light/rc/branch_closed.png");
}

QTreeView:branch:open:has-children:!has-siblings, QTreeView:branch:open:has-children:has-siblings {
  border-image: none;
  image: url(":/icons/light/rc/branch_open.png");
}

QTreeView:branch:has-children:!has-siblings:closed:hover, QTreeView:branch:closed:has-children:has-siblings:hover {
  image: url(":/icons/light/rc/branch_closed_focus.png");
}

QTreeView:branch:open:has-children:!has-siblings:hover, QTreeView:branch:open:has-children:has-siblings:hover {
  image: url(":/icons/light/rc/branch_open_focus.png");
}

QTreeView::indicator:checked,
QListView::indicator:checked,
QTableView::indicator:checked,
QColumnView::indicator:checked {
  image: url(":/icons/light/rc/checkbox_checked.png");
}

QTreeView::indicator:checked:hover, QTreeView::indicator:checked:focus, QTreeView::indicator:checked:pressed,
QListView::indicator:checked:hover,
QListView::indicator:checked:focus,
QListView::indicator:checked:pressed,
QTableView::indicator:checked:hover,
QTableView::indicator:checked:focus,
QTableView::indicator:checked:pressed,
QColumnView::indicator:checked:hover,
QColumnView::indicator:checked:focus,
QColumnView::indicator:checked:pressed {
  image: url(":/icons/light/rc/checkbox_checked_focus.png");
}

QTreeView::indicator:unchecked,
QListView::indicator:unchecked,
QTableView::indicator:unchecked,
QColumnView::indicator:unchecked {
  image: url(":/icons/light/rc/checkbox_unchecked.png");
}

QTreeView::indicator:unchecked:hover, QTreeView::indicator:unchecked:focus, QTreeView::indicator:unchecked:pressed,
QListView::indicator:unchecked:hover,
QListView::indicator:unchecked:focus,
QListView::indicator:unchecked:pressed,
QTableView::indicator:unchecked:hover,
QTableView::indicator:unchecked:focus,
QTableView::indicator:unchecked:pressed,
QColumnView::indicator:unchecked:hover,
QColumnView::indicator:unchecked:focus,
QColumnView::indicator:unchecked:pressed {
  image: url(":/icons/light/rc/checkbox_unchecked_focus.png");
}

QTreeView::indicator:indeterminate,
QListView::indicator:indeterminate,
QTableView::indicator:indeterminate,
QColumnView::indicator:indeterminate {
  image: url(":/icons/light/rc/checkbox_indeterminate.png");
}

QTreeView::indicator:indeterminate:hover, QTreeView::indicator:indeterminate:focus, QTreeView::indicator:indeterminate:pressed,
QListView::indicator:indeterminate:hover,
QListView::indicator:indeterminate:focus,
QListView::indicator:indeterminate:pressed,
QTableView::indicator:indeterminate:hover,
QTableView::indicator:indeterminate:focus,
QTableView::indicator:indeterminate:pressed,
QColumnView::indicator:indeterminate:hover,
QColumnView::indicator:indeterminate:focus,
QColumnView::indicator:indeterminate:pressed {
  image: url(":/icons/light/rc/checkbox_indeterminate_focus.png");
}

QTreeView,
QListView,
QTableView,
QColumnView {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #2D2D2D;
  gridline-color: #D8D8D8;
  border-radius: 4px;
}

QTreeView:disabled,
QListView:disabled,
QTableView:disabled,
QColumnView:disabled {
  background-color: #E5E5E5;
  color: #8A8A8A;
}

QTreeView:selected,
QListView:selected,
QTableView:selected,
QColumnView:selected {
  background-color: #A0A0A0;
  color: #D8D8D8;
}

QTreeView:focus,
QListView:focus,
QTableView:focus,
QColumnView:focus {
  border: 1px solid #909090;
}

QTreeView::item:pressed,
QListView::item:pressed,
QTableView::item:pressed,
QColumnView::item:pressed {
  background-color: #A0A0A0;
}

QTreeView::item:selected:active,
QListView::item:selected:active,
QTableView::item:selected:active,
QColumnView::item:selected:active {
  background-color: #A0A0A0;
}

QTreeView::item:selected:!active,
QListView::item:selected:!active,
QTableView::item:selected:!active,
QColumnView::item:selected:!active {
  color: #2D2D2D;
  background-color: #DDDDDD;
}

QTreeView::item:!selected:hover,
QListView::item:!selected:hover,
QTableView::item:!selected:hover,
QColumnView::item:!selected:hover {
  outline: 0;
  color: #2D2D2D;
  background-color: #DDDDDD;
}

QTableCornerButton::section {
  background-color: #E5E5E5;
  border: 1px transparent #D8D8D8;
  border-radius: 0px;
}

/* QHeaderView ------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qheaderview

--------------------------------------------------------------------------- */
QHeaderView {
  background-color: #D8D8D8;
  border: 0px transparent #D8D8D8;
  padding: 0;
  margin: 0;
  border-radius: 0;
}

QHeaderView:disabled {
  background-color: #D8D8D8;
  border: 1px transparent #D8D8D8;
}

QHeaderView::section {
  background-color: #D8D8D8;
  color: #2D2D2D;
  border-radius: 0;
  text-align: left;
  font-size: 13px;
}

QHeaderView::section::horizontal {
  padding-top: 0;
  padding-bottom: 0;
  padding-left: 4px;
  padding-right: 4px;
  border-left: 1px solid #E5E5E5;
}

QHeaderView::section::horizontal::first, QHeaderView::section::horizontal::only-one {
  border-left: 1px solid #D8D8D8;
}

QHeaderView::section::horizontal:disabled {
  color: #8A8A8A;
}

QHeaderView::section::vertical {
  padding-top: 0;
  padding-bottom: 0;
  padding-left: 4px;
  padding-right: 4px;
  border-top: 1px solid #E5E5E5;
}

QHeaderView::section::vertical::first, QHeaderView::section::vertical::only-one {
  border-top: 1px solid #D8D8D8;
}

QHeaderView::section::vertical:disabled {
  color: #8A8A8A;
}

QHeaderView::down-arrow {
  background-color: #D8D8D8;
  border: none;
  height: 12px;
  width: 12px;
  padding-left: 2px;
  padding-right: 2px;
  image: url(":/icons/light/rc/arrow_down.png");
}

QHeaderView::up-arrow {
  background-color: #D8D8D8;
  border: none;
  height: 12px;
  width: 12px;
  padding-left: 2px;
  padding-right: 2px;
  image: url(":/icons/light/rc/arrow_up.png");
}

/* QToolBox --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qtoolbox

--------------------------------------------------------------------------- */
QToolBox {
  padding: 0px;
  border: 0px;
  border: 1px solid #D8D8D8;
}

QToolBox:selected {
  padding: 0px;
  border: 2px solid #A0A0A0;
}

QToolBox::tab {
  background-color: #E5E5E5;
  border: 1px solid #D8D8D8;
  color: #2D2D2D;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QToolBox::tab:disabled {
  color: #8A8A8A;
}

QToolBox::tab:selected {
  background-color: #B0B0B0;
  border-bottom: 2px solid #A0A0A0;
}

QToolBox::tab:selected:disabled {
  background-color: #D8D8D8;
  border-bottom: 2px solid #C8C8C8;
}

QToolBox::tab:!selected {
  background-color: #D8D8D8;
  border-bottom: 2px solid #D8D8D8;
}

QToolBox::tab:!selected:disabled {
  background-color: #E5E5E5;
}

QToolBox::tab:hover {
  border-color: #909090;
  border-bottom: 2px solid #909090;
}

QToolBox QScrollArea {
  padding: 0px;
  border: 0px;
  background-color: #E5E5E5;
}

/* QFrame -----------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qframe

--------------------------------------------------------------------------- */
.QFrame {
  border-radius: 4px;
  border: 1px solid #D8D8D8;
}

.QFrame[frameShape="0"] {
  border-radius: 4px;
  border: 1px transparent #D8D8D8;
}

.QFrame[frameShape="4"] {
  max-height: 2px;
  border: none;
  background-color: #D8D8D8;
}

.QFrame[frameShape="5"] {
  max-width: 2px;
  border: none;
  background-color: #D8D8D8;
}

/* QSplitter --------------------------------------------------------------

https://doc.qt.io/qt-5/stylesheet-examples.html#customizing-qsplitter

--------------------------------------------------------------------------- */

QSplitter {
  background-color: #D8D8D8;
  spacing: 0px;
  padding: 0px;
  margin: 0px;
}
QSplitter[no-style="true"] {
  background-color: none;
}

QSplitter::handle {
  background-color: #A0A0A4;
  border: 0px solid #E5E5E5;
  spacing: 0px;
  padding: 1px;
  margin: 0px;
}

QSplitter::handle:hover {
  background-color: #909090;
}

QSplitter::handle:horizontal {
  width: 5px;
  image: url(":/icons/light/rc/line_vertical.png");
}

QSplitter::handle:vertical {
  height: 5px;
  image: url(":/icons/light/rc/line_horizontal.png");
}

/* Edit -----------------------------------------------

--------------------------------------------------------------------------- */

Edit[Editor="true"] {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-left: 1px solid #7a7a7a;
  border-right: 1px solid #7a7a7a;
  border-bottom: 1px solid #7a7a7a;
}

/* QDateEdit, QDateTimeEdit -----------------------------------------------

--------------------------------------------------------------------------- */
QDateEdit, QDateTimeEdit {
  selection-background-color: #A0A0A0;
  border-style: solid;
  border: 1px solid #D8D8D8;
  border-radius: 4px;
  padding-top: 2px;
  padding-bottom: 2px;
  padding-left: 4px;
  padding-right: 4px;
  min-width: 10px;
}

QDateEdit:on, QDateTimeEdit:on {
  selection-background-color: #A0A0A0;
}

QDateEdit::drop-down, QDateTimeEdit::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 12px;
  border-left: 1px solid #D8D8D8;
}

QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
  image: url(":/icons/light/rc/arrow_down_disabled.png");
  height: 8px;
  width: 8px;
}

QDateEdit::down-arrow:on, QDateEdit::down-arrow:hover, QDateEdit::down-arrow:focus, QDateTimeEdit::down-arrow:on, QDateTimeEdit::down-arrow:hover, QDateTimeEdit::down-arrow:focus {
  image: url(":/icons/light/rc/arrow_down.png");
}

QDateEdit QAbstractItemView, QDateTimeEdit QAbstractItemView {
  background-color: #E5E5E5;
  border-radius: 4px;
  border: 1px solid #D8D8D8;
  selection-background-color: #A0A0A0;
}

/* QAbstractView ----------------------------------------------------------

--------------------------------------------------------------------------- */
QAbstractView:hover {
  border: 1px solid #A0A0A0;
  color: #2D2D2D;
}

QAbstractView:selected {
  background: #A0A0A0;
  color: #D8D8D8;
}

/* PlotWidget -------------------------------------------------------------

--------------------------------------------------------------------------- */
PlotWidget {
  padding: 0px;
}